{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/provider-view/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|models/|favicon.ico|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}
