# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── FreeLLMAPI (Centralized Unified LLM Router) ──────────────────────────────
# In local dev: http://127.0.0.1:31415/v1
# In Vercel serverless production: Must be an externally reachable HTTPS URL (e.g. https://llm.nexis.example/v1)
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

# ── Fallback & Service AI Keys ───────────────────────────────────────────────
GEMINI_API_KEY=
SARVAM_API_KEY=

# ── Adzuna Job Search ────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Database (Prisma PostgreSQL / Supabase) ─────────────────────────────────
# Pooled connection string for serverless runtime queries (Supavisor port 6543)
DATABASE_URL="postgresql://user.projectref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string for Prisma migrations (port 5432)
DIRECT_URL="postgresql://user.projectref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
FRONTEND_URL=http://localhost:3000

# ── LinkedIn OAuth ───────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
